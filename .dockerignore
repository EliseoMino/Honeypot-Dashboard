# Keep the build context small and prevent host state from leaking into images.
#
# The three application images build from the repository root, so anything not
# listed here would be uploaded to the daemon on every build.

# Version control and tooling caches
.git
.gitignore
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/__pycache__
**/*.py[cod]

# Dependency trees, rebuilt inside the images
**/node_modules
.venv
venv

# Local runtime state: TLS private keys, the ingestion spool, honeypot data
.env
.env.local
.env.*.local
var/
infrastructure/cowrie/data/

# Build output and editor state
dashboard/dist
**/.idea
**/.vscode
**/.DS_Store
