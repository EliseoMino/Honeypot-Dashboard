# Copy to .env and adjust. Every value below is the one compose.yaml uses.
#
#   cp .env.example .env
#   docker compose up -d --build
#   then open http://127.0.0.1:3000 in a browser

# PostgreSQL (local development only)
POSTGRES_USER=honeypot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=honeypot
# Published on the loopback interface only, and only so the test suite and psql
# can reach the database from the host.
POSTGRES_PORT=5432

# Cowrie
# Pinned on purpose: the JSON output section name and the event schema both
# changed between Cowrie 2.x and 3.x, and the agent depends on the 3.x shape.
COWRIE_IMAGE=cowrie/cowrie:3.0.15
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223

# Backend
# The API listens on 8443 inside the compose network. The port is fixed rather
# than configurable because the agent, the nginx proxy and the healthcheck all
# have to agree on it. It is deliberately not published to the host: the
# dashboard is the only client and it authenticates with a client certificate.
LOG_LEVEL=INFO

# Backend storage (RF-03). When the backend runs on the host instead of in
# compose, the database host is 127.0.0.1; inside the compose network compose
# overrides this with the service name `postgres`.
DATABASE_URL=postgresql+asyncpg://honeypot:change-me@127.0.0.1:5432/honeypot
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Backend spool: durability boundary between RF-01/RF-02 and RF-03
SPOOL_DIR=var/spool
SPOOL_MAX_BYTES=67108864
SPOOL_FSYNC=true
SPOOL_REPLAY_ENABLED=true
SPOOL_REPLAY_INTERVAL=1.0
SPOOL_REPLAY_BATCH_SIZE=500
SPOOL_REPLAY_ERROR_BACKOFF=5.0

# Detection rules (RF-11). The path is relative to the working directory, and
# then to the repository, so the backend can be started from either. Rules are
# read at startup: restart the backend to apply a change. Leave it empty to run
# without detection rules; the detection endpoints then answer 503.
DETECTION_RULES_PATH=infrastructure/detection/rules.toml
# Period evaluated by POST /api/v1/detections/run when the caller sends no window.
DETECTION_DEFAULT_LOOKBACK=86400

# Test database. The suite skips every test that needs PostgreSQL when this is
# unset. It must point at a throwaway database: the fixtures drop the RF-03 and
# RF-11 schema before and after each test.
# TEST_DATABASE_URL=postgresql+asyncpg://honeypot:change-me@127.0.0.1:5432/honeypot_test

# Dashboard
# The browser facing port on the loopback interface. nginx serves the built
# bundle here and forwards /api, /healthz and /readyz to the backend over mutual
# TLS, so nothing else has to be reachable from the host.
DASHBOARD_PORT=3000
# The Vite dev server (`npm run dev` in dashboard/) proxies to this address. It
# points at nginx rather than at the backend because the backend demands a client
# certificate that a browser cannot present.
BACKEND_URL=http://127.0.0.1:3000
