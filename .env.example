# PostgreSQL (local development only)
POSTGRES_USER=honeypot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=honeypot
POSTGRES_PORT=5432

# Cowrie
COWRIE_IMAGE=destruct/cowrie
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223

# Backend
BACKEND_PORT=8000

# Backend storage (RF-03). Use the host from the point of view of the process:
# 127.0.0.1 when the backend runs on the host, 'postgres' when it runs inside
# the compose network.
DATABASE_URL=postgresql+asyncpg://honeypot:change-me@127.0.0.1:5432/honeypot
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Backend spool: durability boundary between RF-01/RF-02 and RF-03
SPOOL_DIR=var/spool
SPOOL_MAX_BYTES=67108864
SPOOL_FSYNC=true
SPOOL_REPLAY_ENABLED=true
SPOOL_REPLAY_INTERVAL=1.0
SPOOL_REPLAY_BATCH_SIZE=500
SPOOL_REPLAY_ERROR_BACKOFF=5.0

# Detection rules (RF-11). The path is relative to the working directory, and
# then to the repository, so the backend can be started from either. Rules are
# read at startup: restart the backend to apply a change. Leave it empty to run
# without detection rules; the detection endpoints then answer 503.
DETECTION_RULES_PATH=infrastructure/detection/rules.toml
# Period evaluated by POST /api/v1/detections/run when the caller sends no window.
DETECTION_DEFAULT_LOOKBACK=86400

# Test database. The suite skips every test that needs PostgreSQL when this is
# unset. It must point at a throwaway database: the fixtures drop the RF-03 and
# RF-11 schema before and after each test.
# TEST_DATABASE_URL=postgresql+asyncpg://honeypot:change-me@127.0.0.1:5432/honeypot_test

# Dashboard
DASHBOARD_PORT=3000
